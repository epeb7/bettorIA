# Copie para .env.local e preencha com seus dados reais.
# NUNCA commitar o .env.local (já está no .gitignore).

# Sua chave Pix real (CPF, CNPJ, email, telefone ou chave aleatória)
PIX_KEY=

# Nome e cidade do recebedor, exatamente como cadastrados no seu banco
# (o padrão Pix corta em 25 e 15 caracteres — não é bug se aparecer cortado)
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
