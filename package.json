  "description": "Atalhos pra rodar web/ e engine/ sem precisar entrar na pasta. Cada um continua um projeto independente (ver README.md) — isto não é um workspace compartilhado.",
  "scripts": {
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install",
